{
  "$schema": "https://devhub.local/schemas/plugin-manifest.schema.json",
  "code": "example",
  "name": "示例插件",
  "version": "1.0.0",
  "description": "用于说明 DevHub 插件 Manifest 字段的示例。当前阶段仅作为 SDK / 模板规范，不代表系统已经支持外部插件动态加载。",
  "author": "DevHub Team",
  "homepage": "https://example.com/devhub-plugin-example",
  "license": "MIT",
  "compatible_core_version": ">=1.3.4",
  "min_core_version": "1.3.4",
  "is_system": false,
  "status": "planned",
  "content_types": [
    {
      "type": "example_item",
      "name": "示例内容",
      "plugin_code": "example",
      "create_permission": "example.item.create",
      "edit_permission": "example.item.edit",
      "delete_permission": "example.item.delete",
      "audit_permission": "example.item.audit",
      "default_status": "publish",
      "allow_comment": true,
      "allow_like": true,
      "allow_favorite": true,
      "seo_type": "Article"
    }
  ],
  "permissions": [
    {
      "code": "example.item.create",
      "name": "创建示例内容",
      "description": "允许在已启用该插件的子站中创建示例内容。",
      "scope": "community",
      "plugin_code": "example"
    },
    {
      "code": "example.manage",
      "name": "管理示例插件",
      "description": "允许管理示例插件内容和配置。",
      "scope": "global",
      "plugin_code": "example"
    }
  ],
  "menus": [
    {
      "code": "example.admin",
      "title": "示例内容",
      "path": "/admin-next/example",
      "area": "admin",
      "location": "admin",
      "permission": "example.manage",
      "plugin_code": "example",
      "sort_order": 300
    },
    {
      "code": "example.frontend",
      "title": "示例",
      "path": "/example",
      "area": "frontend",
      "location": "frontend",
      "permission": "example.item.create",
      "plugin_code": "example",
      "sort_order": 300
    }
  ],
  "routes": [
    {
      "area": "admin",
      "method": "GET",
      "path": "/api/v1/admin/example",
      "auth": "admin",
      "handler": "reserved:example.list",
      "permission": "example.manage"
    }
  ],
  "hooks": [
    {
      "name": "BeforeCreateContent",
      "mode": "blocking",
      "timeout_ms": 3000,
      "failure_threshold": 1,
      "failure_policy": "block",
      "description": "创建内容前校验示例内容约束。当前外部插件 Hook 仅为 planned，不会被动态加载执行。"
    },
    {
      "name": "AfterCreateContent",
      "mode": "non_blocking",
      "timeout_ms": 3000,
      "failure_threshold": 3,
      "failure_policy": "log",
      "description": "创建内容后记录统计或通知。"
    }
  ],
  "config_schema": {
    "type": "object",
    "required": ["default_status"],
    "properties": {
      "default_status": {
        "type": "string",
        "title": "默认状态",
        "description": "新建示例内容的默认状态。",
        "enum": ["draft", "publish"],
        "default": "publish"
      },
      "max_items_per_page": {
        "type": "integer",
        "title": "每页最大数量",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "api_token": {
        "type": "string",
        "title": "外部服务 Token",
        "sensitive": true,
        "description": "敏感字段展示和 diff 需要脱敏。"
      }
    }
  },
  "migrations": [
    {
      "plugin_code": "example",
      "migration_version": "1.0.0",
      "migration_name": "example_items",
      "direction": "up",
      "checksum": "reserved",
      "tables": ["example_items"],
      "rollback_supported": false,
      "description": "示例迁移声明。当前外部插件迁移执行器为后续规划。"
    }
  ],
  "dependencies": [
    {
      "plugin_code": "qa",
      "version": ">=1.0.0",
      "optional": true,
      "status": "reserved"
    }
  ],
  "assets": {
    "admin": "admin/index.js",
    "frontend": "frontend/index.js",
    "icon": "assets/icon.svg",
    "status": "reserved"
  },
  "reserved": {
    "package_signature": "planned",
    "external_service": "planned",
    "sandbox": "planned"
  }
}
