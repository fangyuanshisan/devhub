      "handler": "reserved:plugin_content.feishu_links",
      "auth": "admin",
      "permission": "plugin_a7b0cc04.link.audit"
    }
  ],
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "enabled",
      "endpoint_url"
    ],
    "properties": {
      "enabled": {
        "default": false,
        "title": "启用外部服务",
        "type": "boolean"
      },
      "endpoint_url": {
        "default": "http://172.17.0.1:18081",
        "format": "uri",
        "title": "服务地址",
        "type": "string"
      },
      "failure_policy": {
        "default": "warn",
        "enum": [
          "warn",
          "ignore",
          "error",
          "disable_hook"
        ],
        "title": "失败策略",
        "type": "string"
      },
      "health_check_path": {
        "default": "/health",
        "pattern": "^/(?:[^/\\s][^\\s]*)?$",
        "title": "健康检查路径",
        "type": "string"
      },
      "timeout_ms": {
        "default": 3000,
        "maximum": 10000,
        "minimum": 100,
        "title": "超时时间",
        "type": "integer"
      }
    }
  },
  "default_config": {
    "enabled": false,
    "endpoint_url": "http://172.17.0.1:18081",
    "failure_policy": "warn",
    "health_check_path": "/health",
    "timeout_ms": 3000
  },
  "hooks": [
    {
      "plugin_code": "plugin_a7b0cc04",
      "name": "AfterCreateContent",
      "description": "飞书链接创建后投递到外部服务。",
      "mode": "non_blocking",
      "service_type": "external_service",
      "path": "/hooks/content.after_create",
      "method": "POST",
      "retry_enabled": true,
      "max_attempts": 3,
      "enabled": true,
      "blocking": false,
      "critical": false,
      "failure_policy": "warn",
      "timeout_ms": 3000
    }
  ],
  "external_service": {
    "endpoint": "http://172.17.0.1:18081",
    "health_check_path": "/health",
    "subscribed_hooks": [
      "AfterCreateContent"
    ],
    "timeout_ms": 3000,
    "failure_policy": "warn",
    "retry_policy": "linear",
    "signature_algorithm": "hmac-sha256"
  },
  "migrations": [
    {
      "plugin_code": "plugin_a7b0cc04",
      "migration_version": "1.4.1",
      "migration_name": "plugin_a7b0cc04_core_content_type",
      "direction": "up",
      "checksum": "sha256:no-sql-core-content-type",
      "tables": [
        "topics",
        "categories",
        "plugin_configs",
        "plugin_external_services",
        "hook_executions",
        "admin_logs"
      ],
      "rollback_supported": false,
      "description": "plugin_a7b0cc04 使用 Core topics 存储 feishu_link content_type；不创建插件私有业务表。"
    }
  ]
