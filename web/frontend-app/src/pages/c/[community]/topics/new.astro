---
import SiteHeader from '../../../../components/SiteHeader.astro';
import TopicPublishForm from '../../../../components/TopicPublishForm.vue';
import SeoLayout from '../../../../layouts/SeoLayout.astro';
import { communitySiteKeys, devhubSites as sites, findSiteByKey } from '../../../../lib/sites';

export function getStaticPaths() {
  return communitySiteKeys.map((site) => ({ params: { community: site } }));
}

const community = Astro.params.community || '';
const site = findSiteByKey(community) || sites[0];
---
<SeoLayout title={`在 ${site.name} 发布 - DevHub`} description={`在 DevHub ${site.name} 子站发布内容。`} canonical={`/c/${community}/topics/new/`}>
  <SiteHeader sites={sites} activeSite={site.key} />
  <main>
    <section class="page-title">
      <span>发布</span>
      <h1>在当前子站发布</h1>
      <p>{site.description}</p>
    </section>
    <TopicPublishForm client:load defaultCommunity={community} />
  </main>
</SeoLayout>
